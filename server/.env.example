# FoodLoop Server Environment Variables
# Port where the Express API server listens
PORT=5000

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=foodloop
PG_USER=postgres
PG_PASSWORD=your_secure_password_here

# JWT or Session Secret (for native auth)
JWT_SECRET=super_secret_jwt_key_change_in_production

# Node Environment
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
